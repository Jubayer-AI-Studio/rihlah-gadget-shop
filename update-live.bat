@echo off
chcp 65001 >nul
echo ========================================================
echo       রিহলাহ গ্যাজেট শপ — ১-ক্লিক অটো আপডেট ও লাইভ ডিপ্লয়
echo ========================================================
echo.
cd /d "%~dp0"

echo [1/3] গিট-এ পরিবর্তনগুলো সংরক্ষণ করা হচ্ছে...
git add .
git commit -m "Auto update: %date% %time%" 2>nul

echo.
echo [2/3] লাইভ সার্ভারে ডিপ্লয় করা হচ্ছে...
call npx vercel --prod --yes

if %errorlevel% equ 0 (
    echo.
    echo ========================================================
    echo   [সফল!] ওয়েবসাইট সফলভাবে আপডেট হয়ে লাইভ হয়েছে!
    echo   লাইভ লিংক: https://rihlah-gadget-shop.vercel.app
    echo ========================================================
) else (
    echo.
    echo [এরর] ডিপ্লয় করতে সমস্যা হয়েছে। দয়া করে ইন্টারনেট কানেকশন চেক করুন।
)

pause
